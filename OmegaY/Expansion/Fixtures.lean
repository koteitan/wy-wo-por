def checkIndependentFixtures : IO Unit := do
  for (input, copies, expectedValues, expectedGraph) in independentFixtures do
    match expandDiagram input copies with
    | .error err => throw (IO.userError s!"Expansion failed: {input}, N={copies}: {repr err}")
    | .ok mountain =>
      if Canonical.fullSummary mountain != expectedGraph then
        throw (IO.userError s!"Expansion graph mismatch: {input}, N={copies}")
      if valuesOf mountain != .ok expectedValues then
        throw (IO.userError s!"Expansion value mismatch: {input}, N={copies}")
      match Canonical.build expectedValues with
      | .error err => throw (IO.userError s!"Rebuild failed: {input}, N={copies}: {repr err}")
      | .ok rebuilt =>
        if Canonical.fullSummary rebuilt != Canonical.fullSummary mountain then
          throw (IO.userError s!"Canonical reconstruction mismatch: {input}, N={copies}")
  IO.println s!"Verified {independentFixtures.length} independent expansion graphs, all rows/values/left references, and their canonical rebuilds."

#eval checkIndependentFixtures

