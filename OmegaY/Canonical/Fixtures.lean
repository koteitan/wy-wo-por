def checkIndependentFixtures : IO Unit := do
  for (input, expected) in independentFixtures do
    match build input with
    | .error err => throw (IO.userError s!"Canonical construction failed: {input}: {repr err}")
    | .ok mountain =>
      if fullSummary mountain != expected then
        throw (IO.userError s!"Canonical graph mismatch: {input}")
  IO.println s!"Verified {independentFixtures.length} independent canonical graphs, with every row/value/left reference."

#eval checkIndependentFixtures

end OmegaY.Canonical
